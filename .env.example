# Copy to ".env" for local development (never commit .env).
# On Vercel: Project → Settings → Environment Variables (same names, no REACT_APP_ prefix change).

# Firebase — Firebase Console → Project settings → Your apps → SDK setup (Config object)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# The Movie Database — https://www.themoviedb.org/settings/api
REACT_APP_TMDB_API_KEY=
